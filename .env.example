# ==========================================
# BACKEND ENVIRONMENT VARIABLES
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hackathon_platform
SECRET_KEY=change-to-a-secure-random-32-byte-hex-in-production-hackathon-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS & Networking
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","*"]

# Security & Invitations
INVITATION_CODE_LENGTH=12
INVITATION_DEFAULT_EXPIRY_HOURS=72
MAX_INVITATION_ATTEMPTS_PER_IP=10

# Matching Engine Default Weights
WEIGHT_SKILLS=0.40
WEIGHT_TIMEZONE=0.25
WEIGHT_AVAILABILITY=0.20
WEIGHT_ROLE_EXPERIENCE=0.15

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES
# ==========================================
VITE_API_BASE_URL=/api
VITE_WS_URL=ws://localhost:8000/ws
